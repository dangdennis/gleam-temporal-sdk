//// Writes `native/temporal_nif/src/bridge.rs` from the types in
//// `src/temporal/internal/bridge.gleam`, so that the Rust side of the boundary names the
//// same constructors and fields as the Gleam side. Run it with `bin/codegen` after
//// changing a bridge type; the Rust compiler then points at every place that must follow.
////
//// A Gleam record `Foo(a, b)` is the Erlang tuple `{foo, A, B}` and a constructor without
//// fields is a bare atom. Each type becomes a Rust struct or enum with the same field
//// names and a `Wire` implementation that reads and writes that shape.

import glance
import gleam/io
import gleam/list
import gleam/result
import gleam/string
import simplifile

const source = "../src/temporal/internal/bridge.gleam"

const destination = "../native/temporal_nif/src/bridge.rs"

/// Gleam's `Int` has no size. Rust reads one as `i64`, except these fields, whose values
/// use the full unsigned range.
const unsigned = [
  #("InitializeWorkflow", "randomness_seed"),
  #("UpdateRandomSeed", "seed"),
]

const header =
  "// Generated by bin/codegen from src/temporal/internal/bridge.gleam. Do not edit: change
// the Gleam types and run bin/codegen. The types are documented there.
//
// Not every type is used from Rust, and the names and shapes are Gleam's, whose
// constructors share a namespace and so repeat their type's name.
#![allow(dead_code, clippy::enum_variant_names, clippy::large_enum_variant)]

use crate::wire::{Bytes, DecodeResult, Wire, at, atom, record, untag, unexpected};
use rustler::{Env, Term};
use std::collections::HashMap;
use temporalio_common::protos::temporal::api::{common::v1::Payload, failure::v1::Failure};
"

pub fn main() -> Nil {
  let assert Ok(text) = simplifile.read(source)
  let assert Ok(module) = glance.module(text)
  let types =
    // The parser lists definitions last first.
    list.reverse(module.custom_types)
    |> list.map(fn(definition) { definition.definition })
    // A type without constructors is an Erlang value Gleam never looks inside.
    |> list.filter(fn(custom) { custom.variants != [] })
  let names = list.map(types, fn(custom) { custom.name })
  case list.try_map(types, rust_type(_, names)) {
    Ok(generated) -> {
      let assert Ok(Nil) =
        simplifile.write(destination, header <> string.join(generated, ""))
      io.println("wrote " <> destination)
    }
    Error(problem) -> {
      io.println_error(problem)
      halt(1)
    }
  }
}

@external(erlang, "erlang", "halt")
fn halt(status: Int) -> Nil

type Field {
  Field(name: String, rust_type: String)
}

type Variant {
  Variant(name: String, tag: String, fields: List(Field))
}

fn rust_type(
  custom: glance.CustomType,
  names: List(String),
) -> Result(String, String) {
  use variants <- result.try(list.try_map(custom.variants, variant(_, names)))
  Ok(case variants {
    [only] if only.name == custom.name -> rust_struct(only)
    _ -> rust_enum(custom.name, variants)
  })
}

fn variant(
  variant: glance.Variant,
  names: List(String),
) -> Result(Variant, String) {
  use fields <- result.try(
    list.try_map(variant.fields, fn(field) {
      case field {
        glance.LabelledVariantField(item:, label:) -> {
          let field_name = variant.name <> "." <> label
          case list.contains(unsigned, #(variant.name, label)) {
            True -> Ok(Field(label, "u64"))
            False ->
              type_name(item, names)
              |> result.map(Field(label, _))
              |> result.map_error(fn(problem) { field_name <> ": " <> problem })
          }
        }
        glance.UnlabelledVariantField(..) ->
          Error(variant.name <> " has a field without a label")
      }
    }),
  )
  Ok(Variant(variant.name, snake_case(variant.name), fields))
}

fn type_name(
  gleam_type: glance.Type,
  names: List(String),
) -> Result(String, String) {
  let nested = fn(parameters) { list.try_map(parameters, type_name(_, names)) }
  case gleam_type {
    glance.NamedType(name:, parameters:, ..) -> {
      use inner <- result.try(nested(parameters))
      case name, inner {
        "String", [] -> Ok("String")
        "Int", [] -> Ok("i64")
        "Float", [] -> Ok("f64")
        "Bool", [] -> Ok("bool")
        "BitArray", [] -> Ok("Bytes")
        "Nil", [] -> Ok("()")
        "Payload", [] -> Ok("Payload")
        "Failure", [] -> Ok("Failure")
        "List", [item] -> Ok("Vec<" <> item <> ">")
        "Option", [item] -> Ok("Option<" <> item <> ">")
        "Dict", ["String", value] -> Ok("HashMap<String, " <> value <> ">")
        "Result", [ok, error] -> Ok("Result<" <> ok <> ", " <> error <> ">")
        _, [] ->
          case list.contains(names, name) {
            True -> Ok(name)
            False -> Error("no Rust type for " <> name)
          }
        _, _ -> Error("no Rust type for " <> name)
      }
    }
    glance.TupleType(elements:, ..) ->
      nested(elements)
      |> result.map(fn(inner) { "(" <> string.join(inner, ", ") <> ")" })
    _ -> Error("only named types and tuples can cross the boundary")
  }
}

fn rust_struct(variant: Variant) -> String {
  let name = variant.name
  let declared =
    list.map(variant.fields, fn(field) {
      "    pub " <> field.name <> ": " <> field.rust_type <> ",\n"
    })
  let written =
    list.map(variant.fields, fn(field) {
      "self." <> field.name <> ".to_term(env)"
    })
  "\n#[derive(Debug, Clone)]\npub struct "
  <> name
  <> " {\n"
  <> string.concat(declared)
  <> "}\n\nimpl Wire for "
  <> name
  <> " {\n    fn to_term<'a>(&self, env: Env<'a>) -> Term<'a> {\n        "
  <> write(variant.tag, written)
  <> "\n    }\n\n    fn from_term(term: Term) -> DecodeResult<Self> {\n"
  <> "        let (tag, f) = untag(term)?;\n        match (tag.as_str(), f.len()) {\n"
  <> "            "
  <> read("Self", variant)
  <> "            (tag, count) => Err(unexpected(\""
  <> name
  <> "\", tag, count)),\n        }\n    }\n}\n"
}

fn rust_enum(name: String, variants: List(Variant)) -> String {
  let declared =
    list.map(variants, fn(variant) {
      case variant.fields {
        [] -> "    " <> variant.name <> ",\n"
        fields ->
          "    "
          <> variant.name
          <> " {\n"
          <> string.concat(
            list.map(fields, fn(field) {
              "        " <> field.name <> ": " <> field.rust_type <> ",\n"
            }),
          )
          <> "    },\n"
      }
    })
  let written =
    list.map(variants, fn(variant) {
      let names = list.map(variant.fields, fn(field) { field.name })
      let pattern = case names {
        [] -> "Self::" <> variant.name
        _ ->
          "Self::" <> variant.name <> " { " <> string.join(names, ", ") <> " }"
      }
      "            "
      <> pattern
      <> " => "
      <> write(
        variant.tag,
        list.map(names, fn(name) { name <> ".to_term(env)" }),
      )
      <> ",\n"
    })
  let read_arms =
    list.map(variants, fn(variant) {
      "            " <> read("Self::" <> variant.name, variant)
    })
  "\n#[derive(Debug, Clone)]\npub enum "
  <> name
  <> " {\n"
  <> string.concat(declared)
  <> "}\n\nimpl Wire for "
  <> name
  <> " {\n    fn to_term<'a>(&self, env: Env<'a>) -> Term<'a> {\n        match self {\n"
  <> string.concat(written)
  <> "        }\n    }\n\n    fn from_term(term: Term) -> DecodeResult<Self> {\n"
  <> "        let (tag, f) = untag(term)?;\n        match (tag.as_str(), f.len()) {\n"
  <> string.concat(read_arms)
  <> "            (tag, count) => Err(unexpected(\""
  <> name
  <> "\", tag, count)),\n        }\n    }\n}\n"
}

/// The expression that builds a record's term from its fields' terms.
fn write(tag: String, fields: List(String)) -> String {
  case fields {
    [] -> "atom(env, \"" <> tag <> "\")"
    _ ->
      "record(env, \"" <> tag <> "\", &[" <> string.join(fields, ", ") <> "])"
  }
}

/// The match arm that reads a record with this tag and number of fields.
fn read(constructor: String, variant: Variant) -> String {
  let count = list.length(variant.fields)
  let arm = "(\"" <> variant.tag <> "\", " <> string.inspect(count) <> ") => "
  case variant.fields {
    [] -> arm <> "Ok(" <> constructor <> "),\n"
    fields ->
      arm
      <> "Ok("
      <> constructor
      <> " {\n"
      <> string.concat(
        list.index_map(fields, fn(field, index) {
          "                "
          <> field.name
          <> ": at(&f, "
          <> string.inspect(index)
          <> ", \""
          <> variant.name
          <> "."
          <> field.name
          <> "\")?,\n"
        }),
      )
      <> "            }),\n"
  }
}

/// The atom Gleam compiles a constructor name to: `FireTimer` is `fire_timer`.
fn snake_case(name: String) -> String {
  string.to_graphemes(name)
  |> list.index_map(fn(letter, index) {
    case string.lowercase(letter) {
      lower if lower != letter && index > 0 -> "_" <> lower
      lower -> lower
    }
  })
  |> string.concat
}

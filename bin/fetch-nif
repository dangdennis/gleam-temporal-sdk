#!/usr/bin/env bash
# Download a prebuilt NIF for this machine from a GitHub release instead of compiling it,
# which needs no Rust toolchain. Usage: bin/fetch-nif <version tag, such as v0.1.0>
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
tag="${1:?usage: bin/fetch-nif <version tag>}"
repository="${TEMPORAL_GLEAM_REPOSITORY:-dangdennis/gleam-temporal-sdk}"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) target=x86_64-unknown-linux-gnu ;;
  Linux-aarch64) target=aarch64-unknown-linux-gnu ;;
  Darwin-arm64) target=aarch64-apple-darwin ;;
  Darwin-x86_64) target=x86_64-apple-darwin ;;
  *) echo "no prebuilt NIF for $(uname -s) $(uname -m); use bin/build-nif" >&2; exit 1 ;;
esac
mkdir -p "$root/priv"
curl --fail --location --silent --show-error \
  "https://github.com/$repository/releases/download/$tag/libtemporal_nif-$target.so" \
  --output "$root/priv/libtemporal_nif.so"
echo "fetched the NIF for $target"

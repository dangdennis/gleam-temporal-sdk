#!/usr/bin/env bash
# Build the Rust NIF and place it where the Erlang loader looks for it.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cargo build --release --manifest-path "$root/native/temporal_nif/Cargo.toml"
mkdir -p "$root/priv"
built="$root/native/temporal_nif/target/release/libtemporal_nif"
# Erlang loads a NIF from a .so file on macOS too, where cargo writes a .dylib.
if [ -f "$built.dylib" ]; then
  cp "$built.dylib" "$root/priv/libtemporal_nif.so"
else
  cp "$built.so" "$root/priv/libtemporal_nif.so"
fi

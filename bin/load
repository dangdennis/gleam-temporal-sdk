#!/usr/bin/env bash
# Run the load test: thousands of workflows on several workers while workers are killed and
# replaced. Uses the Temporal service on localhost:7233, starting a dev server for the run
# if there is none. Tune with LOAD_WORKFLOWS, LOAD_WORKERS, LOAD_KILL_EVERY_MS and LOAD_POLLS,
# the polls each worker keeps open for workflow tasks and for activity tasks.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
bin/build-nif
gleam build
if ! temporal operator cluster health >/dev/null 2>&1; then
  temporal server start-dev --headless --log-level error >/dev/null 2>&1 &
  server=$!
  trap 'kill "$server"' EXIT
  until temporal operator cluster health >/dev/null 2>&1; do sleep 0.5; done
fi
erl -noshell -pa build/dev/erlang/*/ebin -eval '
  logger:set_handler_config(default, level, none),
  try load:main(), halt(0) catch _:Reason -> io:format("~p~n", [Reason]), halt(1) end.'
